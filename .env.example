# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to 1 for local dev only — keeps SESSION_COOKIE_SECURE=False for plain HTTP.
# Must be unset (or 0) in production.
FLASK_DEBUG=1

# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Must stay the same across deploys/restarts, or in-flight waitlist signups
# (held in the session for ~10 minutes while the user enters their code) break.
FLASK_SECRET_KEY=

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sent.dm (phone verification SMS) ──────────────────────────────────────────
SENTDM_API_KEY=
SENTDM_BASE_URL=https://api.sent.dm/v3
SENTDM_TEMPLATE_VERIFICATION=

# Email verification (Resend)
RESEND_API_KEY=
MAIL_FROM=Hoopsline <noreply@hoopsline.com>
WAITLIST_BASE_URL=https://waitlist.hoopsline.com
